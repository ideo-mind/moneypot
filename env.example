# EVM Configuration for Money Pot
# Creditcoin Testnet Configuration

# WalletConnect Project ID (required for wallet connections)
# Get this from https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# EVM Chain Configuration
VITE_CHAIN_ID=102031
VITE_CHAIN_NAME=Creditcoin Testnet
VITE_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# Contract Addresses
VITE_MONEY_POT_CONTRACT_ADDRESS=0xEC020aA4De9567Ae9dF9f43Da71414aE4932F6f3
VITE_USDC_TOKEN_ADDRESS=0xEC020aA4De9567Ae9dF9f43Da71414aE4932F6f3

# Development Configuration
NODE_ENV=development
PORT=3000
